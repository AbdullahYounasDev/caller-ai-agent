{
  "name": "caller-ai-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-locales.mjs && next build",
    "start": "next start",
    "voice": "node --no-warnings --import ./scripts/alias-register.mjs scripts/voice-gateway.mjs",
    "voice:models": "node --no-warnings --import ./scripts/alias-register.mjs scripts/voice-models.mjs",
    "voice:smoke": "node --no-warnings --import ./scripts/alias-register.mjs scripts/voice-smoke.mjs",
    "voice:gaps": "node --no-warnings --import ./scripts/alias-register.mjs scripts/voice-gaps.mjs",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "i18n:check": "node scripts/check-locales.mjs",
    "test": "node --no-warnings --import ./scripts/alias-register.mjs --test \"tests/**/*.test.mjs\"",
    "test:openrouter": "node scripts/test-openrouter.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "eval:sweep": "node scripts/eval-retrieval.mjs --sweep",
    "audit:chunks": "node --no-warnings --import ./scripts/alias-register.mjs scripts/audit-chunks.mjs",
    "eval:trigger": "node --no-warnings --import ./scripts/alias-register.mjs scripts/eval-trigger.mjs",
    "eval:keyword": "node --no-warnings --import ./scripts/alias-register.mjs scripts/eval-keyword.mjs",
    "eval:real": "node scripts/eval-retrieval-real.mjs",
    "eval:real:sweep": "node scripts/eval-retrieval-real.mjs --sweep",
    "db:check": "node scripts/check-db.mjs",
    "eval:embedding-variants": "node --no-warnings --import ./scripts/alias-register.mjs scripts/eval-embedding-variants.mjs",
    "test:reembed": "node --no-warnings --import ./scripts/test-reembed-register.mjs scripts/test-reembed.mjs",
    "db:backfill-search": "node --no-warnings --import ./scripts/alias-register.mjs scripts/backfill-search-config.mjs",
    "reembed": "node --no-warnings --import ./scripts/alias-register.mjs scripts/reembed.mjs",
    "reembed:dry": "node --no-warnings --import ./scripts/alias-register.mjs scripts/reembed.mjs --dry-run",
    "test:collect": "node --no-warnings --import ./scripts/test-collect-register.mjs scripts/test-collect.mjs",
    "test:agents": "node --no-warnings --import ./scripts/test-collect-register.mjs scripts/test-agents.mjs",
    "test:numbers": "node --no-warnings --import ./scripts/alias-register.mjs scripts/test-numbers.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@google/genai": "^1.15.0",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "^6",
    "@uiw/react-codemirror": "^4.25.12",
    "cloudinary": "^2.11.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sherpa-onnx-node": "^1.13.8",
    "tesseract.js": "^7.0.0",
    "undici": "^8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6",
    "tailwindcss": "^4"
  }
}
