// AI engine slice (Abdul's side). Lives in the `ai_engine` schema of a Postgres
// instance shared with the partner's `tenant_core` schema. We deliberately do NOT
// declare tenant_core models here — cross-schema Prisma relations would put us in
// control of migrations for tables we don't own, and the two sides run different
// migration tools (this is Prisma, tenant_core is managed from an Express/Prisma
// or raw-SQL setup on the partner's side). tenant_id is a plain indexed column;
// referential integrity to tenant_core.tenants(id) is enforced with a raw SQL FK
// added in a migration, once that table exists, not through the Prisma schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["ai_engine"]
  extensions = [vector]
}

model Conversation {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  /// The agent (agent_configs.id) this conversation is held with — fixed when it starts, so a
  /// conversation never changes personality half-way. NULL = the tenant's default agent (a
  /// tenant that has never saved any settings has no agent row yet).
  agentId  String? @map("agent_id")
  channel  String // chat | voice — chat is the internal test surface (§ CLAUDE.md)
  status   String  @default("active") // active | resolved | escalated
  // The language this conversation's agent replies in (en | ur) — a transcript label,
  // stamped from agent_configs.reply_language; the agent understands both whatever it is.
  locale   String  @default("en")

  /// The request being taken in this conversation, if any (src/lib/collect/engine.js): a
  /// draft appointment or callback, filled in over several messages and cleared once it is
  /// saved, cancelled or abandoned. One JSON document, never queried — a record only
  /// becomes a row in `records` when the customer confirms it.
  collectDraft Json? @map("collect_draft")

  /// Whether the agent has failed to understand the caller, and whether the conversation has
  /// been passed to a person (src/lib/handoff/decide.js): { v, misses, status, reason, at }.
  /// One small JSON document, never queried.
  handoffState Json?    @map("handoff_state")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@index([tenantId])
  @@index([agentId])
  @@map("conversations")
  @@schema("ai_engine")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  tenantId       String   @map("tenant_id")
  channel        String // chat | voice — channel THIS message came in on
  role           String // user | assistant | system | tool
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([tenantId, channel])
  @@map("messages")
  @@schema("ai_engine")
}

// Prisma Client can read/write every column here EXCEPT `embedding` — the
// `vector` type isn't natively supported, so it comes through as Unsupported().
// Inserts/updates to embedding and similarity search both go through
// prisma.$queryRaw / $executeRaw (see lib/agent/ingest.js and retrieve.js).
//
// vector(768): sized for Gemini's gemini-embedding-001 model with
// outputDimensionality pinned to 768 (see lib/agent/gemini.js). If the
// embedding model or its dimension ever changes, this column size and every
// existing row's embedding both have to change together — there's no way to
// mix dimensions in one column.
/// A DOCUMENT a business gave its agent — one row per thing they uploaded or
/// typed. This is the record they see, rename, edit and delete; chunks are an
/// implementation detail beneath it.
///
/// WHY THIS TABLE EXISTS: without it, ingest was insert-only. Re-uploading a
/// corrected price list left the OLD chunks in place competing with the new
/// ones in retrieval, and the agent would sometimes quote a price the business
/// had already fixed. A stable id per document is what makes "replace" and
/// "delete" possible at all.
model KnowledgeSource {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// What the business calls it. Unique per tenant so re-uploading the same
  /// filename REPLACES rather than duplicates — that is the whole point.
  title String

  /// "text" (typed in the dashboard) | "file" (uploaded) | "url" (crawled)
  kind String @default("text")

  /// The extracted plain text, kept verbatim.
  ///
  /// Stored for two reasons: a business can re-read and EDIT what it gave the
  /// agent, and re-chunking (a better splitter, a different chunk size) can be
  /// replayed without asking them to upload everything again. Chunks are
  /// derived data; this is the original.
  content String

  /// Upload provenance. Null for typed text.
  fileName String? @map("file_name")
  mimeType String? @map("mime_type")
  byteSize Int?    @map("byte_size")

  /// The ORIGINAL uploaded bytes, in Cloudinary — never what the agent answers
  /// from (that's `content`, extracted text). Only set for kind "file". Null
  /// when Cloudinary isn't configured or the upload failed: the original is
  /// optional, the extracted text is not. `filePublicId` is what lib/agent/
  /// storage.js needs to delete the asset when this document is replaced or
  /// deleted — the URL alone isn't enough to address it for deletion.
  fileUrl      String? @map("file_url")
  filePublicId String? @map("file_public_id")

  /// Denormalised so the list screen doesn't COUNT chunks per row.
  chunkCount Int @default(0) @map("chunk_count")

  /// The embedding scheme this document's chunks were embedded under — see
  /// src/lib/agent/embed-scheme.js. 0 is the original scheme. `npm run reembed`
  /// rebuilds every document below the current version, which is what makes it
  /// resumable after a quota stop, and `npm run db:check` fails while any
  /// ready document is behind. Rows embedded before this column existed read 0.
  embeddingScheme Int @default(0) @map("embedding_scheme")

  /// "ready" | "processing" | "failed" — embedding a large PDF is not a
  /// request-response operation, and a business needs to see which it is.
  status String  @default("ready")
  error  String?

  chunks KnowledgeChunk[]

  /// WHICH AGENTS may answer from this document (CLAUDE.md §6.28). NO rows = shared: every
  /// agent of the tenant uses it (the default, and what every document was before agents).
  /// One or more rows = ONLY those agents. Read by retrieval on every turn.
  agents KnowledgeSourceAgent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, title])
  @@index([tenantId])
  @@map("knowledge_sources")
  @@schema("ai_engine")
}

model KnowledgeChunk {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Cascade: deleting a document deletes its chunks in one statement, with no
  /// window where a source is gone but its chunks still answer questions.
  sourceId String          @map("source_id")
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// Denormalised title, so retrieval can cite a source without a join on the
  /// hot path. Rewritten when a document is renamed.
  sourceTitle String @map("source_title")

  /// The heading path this chunk sits under, e.g. "Pricing > Whitening".
  /// Prepended to the embedded text so a chunk about "250 euros" still matches
  /// a question about "whitening" even when the word appears only in the heading.
  heading String?

  /// Position within the document, for stable ordering when showing a preview.
  ordinal Int @default(0)

  content   String
  embedding Unsupported("vector(768)")

  /// SHA-256 (hex) of the exact embedText this row's vector was computed from. Lets a
  /// replace re-use the vector of any chunk whose text did not change (ingest.js, §6.21).
  /// NULL = unknown, never reusable. See the migration for why it is stored, not derived.
  embedHash String? @map("embed_hash")

  /// Text-search config this chunk's keyword index uses — "english" | "italian" |
  /// "simple" — chosen per DOCUMENT at ingest (src/lib/agent/language.js).
  /// regconfig, not text: a generated column needs an IMMUTABLE expression.
  searchConfig Unsupported("regconfig") @default(dbgenerated("'english'::regconfig")) @map("search_config")

  /// GENERATED ALWAYS AS (to_tsvector(search_config, content)) STORED — precomputed so
  /// retrieval does not tokenise every candidate per query. Written by Postgres, never
  /// by us. Deliberately NO GIN index: we only rank vector-admitted rows (§6.3).
  contentTsv Unsupported("tsvector")? @default(dbgenerated()) @map("content_tsv")
  createdAt  DateTime                 @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([sourceId])
  /// ⚠️⚠️ THERE IS AN HNSW INDEX ON `embedding` THAT PRISMA CANNOT SEE. ⚠️⚠️
  ///
  ///   knowledge_chunks_embedding_idx
  ///   USING hnsw (embedding ai_engine.vector_cosine_ops)
  ///
  /// Prisma 6 has no `Hnsw` index type, so it cannot be declared here — and
  /// because Prisma does not know it exists, **`prisma migrate diff` emits a
  /// `DROP INDEX` for it every single time.** Dropping it does not error and
  /// nothing breaks visibly; every similarity query just silently reverts to a
  /// sequential scan, which is invisible at 14 chunks and crippling at 10,000.
  ///
  /// SO: never paste a generated migration in unread. Delete that DROP INDEX
  /// line. `npm run db:check` verifies the index is still there.
  @@map("knowledge_chunks")
  @@schema("ai_engine")
}

/// "This document is for THIS agent" — one row per (document, agent). A document with no rows
/// here is shared by all of the tenant's agents; with rows, only those agents retrieve it
/// (src/lib/agent/knowledge-access.js). Both sides cascade: deleting a document or an agent
/// removes its links, never the other side.
model KnowledgeSourceAgent {
  sourceId  String          @map("source_id")
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  agentId   String          @map("agent_id")
  agent     AgentConfig     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Denormalised so a tenant's links are listed without a join, and every query stays tenant-scoped.
  tenantId  String          @map("tenant_id")
  createdAt DateTime        @default(now()) @map("created_at")

  @@id([sourceId, agentId])
  @@index([agentId])
  @@index([tenantId])
  @@map("knowledge_source_agents")
  @@schema("ai_engine")
}

/// ONE CALL — today a voice session from the test console, later a phone call. Written
/// only by the voice gateway (src/lib/voice/calls.js). What was SAID lives in `messages`
/// under `conversationId`, exactly like a chat (one brain, one transcript store, §1);
/// this row and its turns/events are what a call adds on top: how it went, how fast it
/// was, and why it ended.
///
/// `createdAt` is the moment the call was answered.
model CallLog {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  /// The agent that answered (agent_configs.id); NULL = the tenant's default agent. With
  /// telephony this is the agent the dialled number points to.
  agentId        String? @map("agent_id")
  conversationId String? @map("conversation_id")

  /// "browser" (test console) | "twilio" (later). The call session is identical for
  /// both; only the transport adapter in src/lib/voice/transports/ differs.
  transport String @default("browser")

  /// "active" | "completed" | "failed"
  status String @default("active")

  /// caller_hangup | idle_timeout | max_duration | disconnected | server_shutdown |
  /// setup_failed | error — END_REASONS in src/lib/voice/protocol.js
  endReason String? @map("end_reason")

  /// E.164 numbers once telephony exists. Null for browser sessions — except a console call
  /// placed "as if dialling" one of the tenant's numbers, which records the number it simulated.
  fromNumber    String? @map("from_number")
  toNumber      String? @map("to_number")
  /// The phone number the call came in on (phone_numbers.id), for per-number reporting (§6.29).
  /// Kept as a plain id: a released number keeps its call history.
  phoneNumberId String? @map("phone_number_id")

  /// The models that served this call — { vad, stt, tts: {en, it}, llm } — so a
  /// latency or quality regression can be traced to a model change.
  engine Json?

  turnCount     Int @default(0) @map("turn_count")
  /// How many times the caller talked over the agent (barge-in).
  interruptions Int @default(0)

  /// MEDIAN end-of-speech → first-audio latency across the call's turns, in ms — the
  /// single number that says whether the call felt responsive.
  medianResponseMs Int? @map("median_response_ms")

  endedAt      DateTime? @map("ended_at")
  durationSec  Int?      @map("duration_sec")
  recordingUrl String?   @map("recording_url") // raw audio → object storage, only the URL lives here
  createdAt    DateTime  @default(now()) @map("created_at")

  turns  CallTurn[]
  events CallEvent[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([agentId, createdAt])
  @@index([phoneNumberId, createdAt])
  @@map("call_logs")
  @@schema("ai_engine")
}

/// ONE EXCHANGE in a call: what the caller said, what the agent answered, what the
/// caller was after (intent), whether the knowledge base could answer it (outcome),
/// and how long every stage took. One row per caller utterance that reached the brain.
model CallTurn {
  id       String  @id @default(uuid())
  callId   String  @map("call_id")
  call     CallLog @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenantId String  @map("tenant_id")

  /// 1-based position in the call. The agent's greeting is not a turn.
  index Int

  callerText  String  @map("caller_text")
  agentText   String  @map("agent_text")
  /// What the caller actually HEARD. Shorter than agentText when they interrupted.
  spokenText  String? @map("spoken_text")
  interrupted Boolean @default(false)

  /// The language the reply was SPOKEN in — "en" | "it".
  language String?

  /// Rule-based, from src/lib/voice/intent.js — never a model call:
  ///   intent  question | followup | greeting | acknowledgement | goodbye | human_request
  ///   outcome answered | no_knowledge | conversational | handoff_requested | failed
  intent  String
  outcome String
  /// The document the answer was grounded in (humanised title), when there was one.
  topic   String?

  /// Document titles retrieval handed the model, closest first.
  sources       Json    @default("[]")
  searchQuery   String? @map("search_query")
  rewriteStatus String? @map("rewrite_status")
  /// Which provider/model answered, e.g. "gemini:gemini-3.5-flash-lite".
  model         String?

  /// End-of-speech → first audio sent, in ms. The headline latency of the turn.
  responseMs Int? @map("response_ms")
  /// Every stage: { speechMs, sttMs, retrievalMs, rewriteMs, llmFirstTokenMs, llmMs,
  /// ttsFirstAudioMs, responseMs }. JSON because stages will be added; responseMs is
  /// also a column because it is the one that gets queried.
  timings    Json @default("{}")

  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([callId, index])
  @@index([tenantId, intent])
  @@map("call_turns")
  @@schema("ai_engine")
}

/// THE CALL'S TIMELINE — an append-only log of everything that happened, in order:
/// speech started/ended, transcribed, retrieved, first audio, interrupted, ended… It
/// is what the console shows live and what someone debugging "why was that call
/// slow / why did it cut me off" reads afterwards.
model CallEvent {
  id       String  @id @default(uuid())
  callId   String  @map("call_id")
  call     CallLog @relation(fields: [callId], references: [id], onDelete: Cascade)
  tenantId String  @map("tenant_id")

  /// Order within the call, from 1. Writes are fire-and-forget (they must never slow a
  /// turn down), so order is carried explicitly rather than inferred from timestamps.
  seq  Int
  /// e.g. "call.started", "speech.ended", "stt.completed", "turn.completed"
  type String
  /// Milliseconds since the call started — a timeline that reads the same however the
  /// server clock is set.
  atMs Int    @map("at_ms")
  data Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([callId, seq])
  @@map("call_events")
  @@schema("ai_engine")
}

// Audit log of actions the agent actually executed against the tenant's systems.
model AgentAction {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String?  @map("conversation_id")
  actionType     String   @map("action_type") // e.g. refund_issued | appointment_booked | record_updated
  payload        Json // structured details of what was done — never a text blob
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("agent_actions")
  @@schema("ai_engine")
}

// ONE AGENT — the "businesses train/edit their agent" surface. A tenant has one or more
// (a restaurant chain: one per branch; a call centre: one per line or client). The AI engine
// is the one brain every agent uses; a row here is WHICH setup it answers with: persona,
// hours, voice, language, what it collects and who it forwards calls to. `id` is the
// agent's id everywhere (conversations, call_logs, records, later phone numbers).
//
// WHY THIS LIVES IN ai_engine, NOT tenant_core: the partner owns tenants, users,
// auth, plans and billing. This row is the AI engine's own concern — persona,
// capabilities and prompt-facing settings all change whenever the prompt
// pipeline changes,
// so keeping it on our side means prompt iteration never waits on their migrations.
// The partner's dashboard edits it through /api/agent-config and /api/agents.
model AgentConfig {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // --- which agent this is (src/lib/tenant/config.js) ---
  /// What the owner calls it ("Dublin branch", "Sales line"). Empty = unnamed; the console
  /// shows the business name instead.
  name       String  @default("")
  /// "active" | "archived". Archived, never deleted: calls and requests point at it.
  status     String  @default("active")
  /// Set to tenant_id on the tenant's DEFAULT agent and NULL on every other — a plain unique
  /// column, so the database itself guarantees at most one default per tenant (NULLs never
  /// collide) without a partial index Prisma could not see (§6.1). The default answers every
  /// request that names no agent, and carries the tenant-wide uiLocale.
  defaultFor String? @unique @map("default_for")

  // --- identity / persona: what the agent says it is ---
  businessName String @map("business_name")
  purpose      String @default("") // what the agent is here to do, in the tenant's words
  tone         String @default("professional") // professional | friendly | concise | formal
  timezone     String @default("UTC") // IANA name — needed for hours + booking

  // --- language ---
  // TWO SETTINGS, and they answer different questions. Never merge them.
  //
  // uiLocale       "en" | "ur" — the INTERFACE language. Drives the dashboard
  //                Every screen a business owner reads. One choice, one dropdown.
  //
  // replyLanguage  "en" | "ur" — what the AGENT REPLIES IN. It always UNDERSTANDS both
  //                languages (and the two mixed), whichever is chosen. It is NOT a
  //                locale: it never reaches the translation lookup, it becomes an
  //                instruction to the model in prompt.js.
  //
  // A clinic can run its dashboard in English while its agent answers callers in
  // Urdu. One field cannot express that.
  uiLocale      String @default("en") @map("ui_locale")
  replyLanguage String @default("en") @map("reply_language")

  // --- free-form structured settings ---
  // hours:      { mon: [["09:00","17:00"]], ... } — opening hours in `timezone`
  // escalation: { email, phone, whenUserAsks, whenAgentUnsure }
  hours      Json?
  escalation Json?

  // Per-capability tenant state, keyed by a capability id from
  // lib/agent/capabilities/catalog.js:
  //   { book_appointment: { enabled: true, channels: ["voice"], params: {...} } }
  //
  // JSON rather than a table ON PURPOSE: the catalog of what's possible lives in
  // code, and only the tenant's on/off + params live here. A capabilities TABLE
  // would mean a migration every time we add a capability. If you ever need to
  // query "which tenants enabled X", add a GIN index on this column.
  capabilities Json @default("{}")

  // The agent's VOICE on calls, per spoken language: { en: "kokoro:af_heart", ur: "kokoro:hm_omega" }.
  // Ids come from src/lib/voice/speech/voices.js (the only voices the models actually
  // have); a language left out speaks with that language's default voice. JSON, like
  // capabilities, because the catalog of voices lives in code.
  voices Json @default("{}")

  // --- what the agent collects (src/lib/collect/config.js) ---
  /// Which details the agent asks for, for which kinds of request (appointment, callback…),
  /// and the business's own lists (services, staff) and custom fields. One JSON document,
  /// validated on write by PUT /api/collect; NULL = the feature has never been set up (off).
  collect        Json?
  /// Bumped on every save of `collect`, so a record can say which version of the questions
  /// it was taken under.
  collectVersion Int   @default(0) @map("collect_version")

  /// Documents restricted to this agent (knowledge_source_agents). Shared documents have no
  /// row and are not listed here.
  knowledge KnowledgeSourceAgent[]

  /// Phone numbers that ring this agent (phone_numbers) — each number has exactly one agent.
  phoneNumbers PhoneNumber[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("agent_configs")
  @@schema("ai_engine")
}

/// A unit of work that takes too long to do inside a request.
///
/// Embedding a 40-page PDF is thirty-odd model calls; OCR of a scanned one is
/// slower still. Doing that inline means an HTTP request open for minutes, a
/// business staring at a spinner with no idea whether anything is happening,
/// and a proxy timeout silently killing the upload half-finished.
///
/// So the upload returns a JOB immediately and the work happens behind it. The
/// row is what makes progress observable: the dashboard polls it, and because
/// it is in the DATABASE rather than only in memory, a business can reload the
/// page mid-import and still see where it got to.
model IngestJob {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The document this job is building. Null until the source row exists.
  sourceId String? @map("source_id")
  title    String
  kind     String  @default("file") // text | file | url

  /// queued | processing | done | failed | cancelled
  status String @default("queued")

  /// What it is doing RIGHT NOW — extracting | ocr | chunking | embedding.
  /// Shown to the business, because "embedding 12 of 40" is reassuring in a way
  /// that an unlabelled progress bar is not.
  stage String @default("queued")

  /// 0–100. Derived from the stage weights in lib/agent/jobs.js rather than
  /// stored per-stage, so the bar never goes backwards.
  progress Int @default(0)

  /// Unit counts for the current stage, e.g. chunks embedded or pages OCR'd.
  itemsDone  Int @default(0) @map("items_done")
  itemsTotal Int @default(0) @map("items_total")

  /// Upload provenance, kept so a failed job can still say what it was about.
  fileName String? @map("file_name")
  byteSize Int?    @map("byte_size")

  error String?

  /// Set when the job leaves the queue, so a job abandoned by a process crash
  /// can be told apart from one that is genuinely still working.
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("ingest_jobs")
  @@schema("ai_engine")
}

// ── REQUESTS THE AGENT TAKES (appointments, callbacks) ─────────────────────
//
// ⚠ STAND-INS FOR THE PARTNER'S SIDE. Customers and their requests belong to the backend
// (tenant_core: end_customers, bookings, notifications — docs/handoff-to-backend.md). Until
// that exists the engine keeps them here so the whole flow can be built and tested end to
// end. Everything touching these two tables goes through src/lib/standins/, so replacing
// them is replacing one folder, not hunting through the code. The AGENT never reads them
// back: what it knows about a customer is the conversation.

/// A person who asked for something. Found again by phone number, so a customer who calls
/// twice is one row.
model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String?
  /// International form, +923001234567.
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  records Record[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
  @@schema("ai_engine")
}

/// One request a customer confirmed: an appointment or a callback. Always saved as
/// "requested" — only a person confirms it (CLAUDE.md §6.11).
model Record {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  /// What a customer is told and a business searches by: AP-4K7Q2, CB-9XM3T.
  reference      String
  /// appointment | callback (src/lib/collect/catalog.js)
  type           String
  /// requested | confirmed | done | cancelled
  status         String    @default("requested")
  /// The agent that took it (agent_configs.id); NULL = the tenant's default agent.
  agentId        String?   @map("agent_id")
  conversationId String?   @map("conversation_id")
  customerId     String?   @map("customer_id")
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// chat | voice — where it was taken
  channel        String    @default("chat")
  /// en | ur — the language the customer was served in
  language       String    @default("en")
  /// The details by field id: { name, phone, service, datetime… } — values as validated
  /// (phone in international form, a choice as the owner's option id).
  data           Json
  /// One line for lists: "Ahmed · Root canal · Thursday, 22 October 2026 at 5:00 pm"
  summary        String    @default("")
  /// The day and time asked for, exactly as the customer meant it in the business's own
  /// time zone: "2026-10-22T17:00". A STRING on purpose — it is a wall-clock time, and
  /// turning it into an instant is a decision for whoever schedules it.
  scheduledLocal String?   @map("scheduled_local")
  timezone       String    @default("UTC")
  /// agent_configs.collect_version when it was taken
  configVersion  Int       @default(0) @map("config_version")
  /// Makes saving idempotent: the same confirmation twice is one row.
  submissionKey  String    @map("submission_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, submissionKey])
  @@unique([tenantId, reference])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, type])
  @@index([agentId, createdAt])
  @@map("records")
  @@schema("ai_engine")
}

// ── PHONE NUMBERS (§6.29) ───────────────────────────────────────────────────
//
// ⚠ STAND-IN FOR THE PARTNER'S SIDE, like customers and records above. Buying, porting, releasing
// and billing a number is the backend's (docs/handoff-to-backend.md B11); the engine only needs to
// answer "this number was dialled — which tenant and which agent?". Everything touching this table
// goes through src/lib/standins/numbers.js, and the ENGINE reads it only through
// tenant/registry.js resolveDialledNumber() — the one function that changes when the backend's
// lookup exists.

/// One phone number of a tenant. It rings exactly ONE agent (or none yet); an agent may have many.
model PhoneNumber {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  /// International form, "+442071234567" — what a provider's webhook sends as the dialled number.
  e164        String
  /// = e164 while the number is active, NULL once released: a plain UNIQUE column, so the database
  /// guarantees an active number belongs to ONE tenant, while a released one can be bought again
  /// (by anyone) — the same trick as agent_configs.default_for, no partial index Prisma cannot see.
  activeE164  String?      @unique @map("active_e164")
  /// The agent it rings. NULL = not linked yet: a call to it is refused politely, never guessed.
  agentId     String?      @map("agent_id")
  agent       AgentConfig? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// What the owner calls it ("Main line", "Dublin bookings").
  label       String       @default("")
  /// "active" | "released"
  status      String       @default("active")
  /// "purchased" (a number bought through us) | "forwarding" (the hidden number a business forwards
  /// its own line to) — informational for the backend; routing treats both the same.
  kind        String       @default("purchased")
  /// "twilio" — and the provider's id for it, once numbers are really bought.
  provider    String       @default("twilio")
  providerSid String?      @map("provider_sid")
  releasedAt  DateTime?    @map("released_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([agentId])
  @@index([e164])
  @@map("phone_numbers")
  @@schema("ai_engine")
}
