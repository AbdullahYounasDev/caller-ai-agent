# ─────────────────────────────────────────────────────────────────────────────
# caller-ai-agent — every environment variable the engine reads.
# Copy to .env and fill in. NEVER commit .env (it is gitignored); keep THIS file current
# whenever a variable is added, renamed or removed (CLAUDE.md §11 — handover documents).
# The ENGINE keeps only its own secrets (model keys); storage, billing, messaging and the
# Twilio account belong to the backend (docs/handoff-to-backend.md B6).
# ─────────────────────────────────────────────────────────────────────────────

# ── required ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (npm run db:up). Must include ?schema=ai_engine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caller-ai-agent?schema=ai_engine
# Embeddings are Gemini only and not swappable (CLAUDE.md §6.2); also the default chat model.
GEMINI_API_KEY=

# ── security ────────────────────────────────────────────────────────────────
# Guards every route (header x-internal-key). Leave EMPTY locally (the test console cannot send
# it; allowed with a warning in development). REQUIRED in production — it fails closed.
INTERNAL_API_KEY=
# Signs the one-minute voice tickets; Next.js and the voice gateway must share it.
# Falls back to INTERNAL_API_KEY; with neither, production refuses every call.
VOICE_SESSION_SECRET=

# ── chat model (CLAUDE.md §6.2, §6.24) ──────────────────────────────────────
# gemini | groq | openrouter. groq is the fast one for voice; keep gemini as the fallback.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
# Each Gemini model has its own free daily quota — switching models is how to keep working.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Optional faster/cheaper model for the follow-up rewrite (§6.19). Empty = the chat model.
GEMINI_REWRITE_MODEL=

# Groq: one free key for the fast chat model AND Urdu speech recognition (§6.24).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_REWRITE_MODEL=
GROQ_STT_MODEL=whisper-large-v3
# Only to point at another OpenAI-compatible endpoint.
GROQ_BASE_URL=

# OpenRouter (or any OpenAI-compatible endpoint, e.g. a local Ollama, via OPENROUTER_BASE_URL).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_REWRITE_MODEL=
OPENROUTER_BASE_URL=
# Sent to OpenRouter as the referer header.
PUBLIC_APP_URL=http://localhost:3000

# ── original uploaded files (optional, CLAUDE.md §6.13) ─────────────────────
# All three or none. Without them uploads still work; the original file is just not kept.
# Owned by the backend in the agreed split (handoff B5) — the engine runs without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── voice gateway (optional, CLAUDE.md §6.24) ───────────────────────────────
VOICE_GATEWAY_PORT=3001
# Only when the browser reaches the gateway somewhere other than this host on that port.
VOICE_GATEWAY_PUBLIC_URL=
# Where npm run voice:models put the speech models (default: models/voice).
VOICE_MODELS_DIR=
VOICE_STT_THREADS=2
# Default: every logical core.
VOICE_TTS_THREADS=
# auto | local | groq — auto = Groq Whisper when GROQ_API_KEY is set, else local Parakeet (no Urdu).
VOICE_STT_PROVIDER=auto
# Only "local" today.
VOICE_TTS_PROVIDER=local

# ── scripts only (not read by the app) ──────────────────────────────────────
# Where the eval / OpenRouter scripts find the running app.
APP_URL=http://localhost:3000
EVAL_TENANT=
TEST_TENANT=
FAKE_PORT=
EMBED_VARIANTS_CACHE=
